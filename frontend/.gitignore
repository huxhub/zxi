# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor and operating-system files
.idea/
.vscode/
Thumbs.db
Desktop.ini
*.swp
*.swo

# local test and audit output
/playwright-report/
/test-results/
/.lighthouseci/
/*-audit*.png
/heading-*.png
*.log

# raw website export and scraping tools
/export-zxi-source.ps1
/zxi-source/*
!/zxi-source/images.json

# original 63 MB source video; the optimized production video is committed
/public/zxi hero video.webm

# obsolete and unused local source files
/src/app/homepage.js

# Original project uploads and intermediate copy; selected images live in public/projects/
/public/PROJECTS DETAILS/
/public/project-images/
/public/european-interiors/
/public/europe-interiors/

# Original furniture PDFs; optimized catalog photos live in public/products/
/public/wetransfer_furnatures_2026-10-27_1234/

# graphify
graphify-out/
**/graphify-out/
.graphify*


# Agent workflows and task tracking
/.gsd/
**/.gsd/

# Backups and temporary test artifacts
*.bak
/public/test_*
/public/test-*

# Raw scraped client assets (optimized production assets are in /public/partners/)
/public/clients/

# Raw camera video footage and uncompressed footage
/public/hero banner video/

# Intermediate hero video test encodes (production videos are hero-desktop-native-hq-v5, hero-tablet, hero-mobile)
/public/media/hero/*
!/public/media/hero/hero-desktop-native-hq-v5.mp4
!/public/media/hero/hero-mobile.mp4
!/public/media/hero/hero-tablet.mp4

# Raw intermediate package image downloads (production assets are in /public/packages/)
/public/packages image/
