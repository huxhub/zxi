# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor and operating-system files
.idea/
.vscode/
Thumbs.db
Desktop.ini
*.swp
*.swo

# local test and audit output
/playwright-report/
/test-results/
/.lighthouseci/
*.log

# raw website export and scraping tools
/export-zxi-source.ps1
/zxi-source/*
!/zxi-source/images.json

# original 63 MB source video; the optimized production video is committed
/public/zxi hero video.webm

# obsolete and unused local source files
/src/app/homepage.js
